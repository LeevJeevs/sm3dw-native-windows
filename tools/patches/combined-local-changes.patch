@@ -573,17 +575,34 @@ std::filesystem::path available_sibling(const std::filesystem::path& output,
     }
 }
 
+// Windows can deny renaming a directory while a scanner still holds handles on
+// freshly written files inside it, so retry with a short backoff.
+void rename_with_retry(const std::filesystem::path& from,
+                       const std::filesystem::path& to) {
+    for (int attempt = 0;; ++attempt) {
+        try {
+            std::filesystem::rename(from, to);
+            return;
+        } catch (const std::filesystem::filesystem_error&) {
+            if (attempt >= 60) {
+                throw;
+            }
+            std::this_thread::sleep_for(std::chrono::milliseconds(500));
+        }
+    }
+}
+
